# Database: Turso in production. Leave empty locally to use data/projguard.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# At least one provider key enables the AI features. Providers are tried in LLM_PROVIDERS order.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# LLM_PROVIDERS=gemini,groq,mistral,openrouter
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Signs session cookies. Required in production: generate with `openssl rand -hex 32`.
SESSION_SECRET=
